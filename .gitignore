# ==========================================
# G-Monitor Diskoperindag Banyuasin - .gitignore
# ==========================================

# Node modules & dependencies
node_modules/
package-lock.json.bak

# Logs & Error files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Sensitive credentials, backend & local data
.env
.env.*
.clasprc.json
.clasp.json
.claspignore
credentials.json
token.json
data/
config.json
Code.gs

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE & Editor folders
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.swp
*.swo

# Temporary build / scratch artifacts
scratch/
*.tmp
